+  /* Queue notification links until authentication and profiles are ready. */
+  let pendingChat = null, chatTimer = null;
+  function queueChat(id) {
+    if (typeof id !== 'string' || !id || id.length > 256) return false;
+    pendingChat = id;
+    if (!chatTimer) chatTimer = setInterval(() => {
+      if (me && profiles[pendingChat]) {
+        const target = pendingChat;
+        pendingChat = null; clearInterval(chatTimer); chatTimer = null;
+        openChat(target);
+      }
+    }, 400);
+    return true;
+  }
+  if ('serviceWorker' in navigator) navigator.serviceWorker.addEventListener('message', (event) => {
+    if (event.data?.type !== 'open-chat' || !queueChat(event.data.id)) return;
+    if (event.ports && event.ports[0]) event.ports[0].postMessage('queued');
+  });
+  queueChat(new URLSearchParams(location.search).get('chat'));
+})();
